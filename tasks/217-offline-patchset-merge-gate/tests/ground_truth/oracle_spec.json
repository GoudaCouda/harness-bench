{
  "schema_version": 1,
  "task_id": "217-offline-patchset-merge-gate",
  "checks": [
    {
      "id": "merge_log_state",
      "label": "The merge log matches the canonical gate",
      "weight": 6,
      "condition": {
        "type": "file_equals",
        "path": "state/merge_log.json",
        "expected_path": "reference/state/merge_log.json",
        "format": "json"
      }
    },
    {
      "id": "receipt_summary",
      "label": "The receipt reports the canonical clock and counts",
      "weight": 2,
      "condition": {
        "type": "json",
        "path": "state/merge_receipt.json",
        "pointer": "",
        "op": "contains",
        "expected_from": {
          "path": "ground_truth.json",
          "format": "json",
          "pointer": "/artifacts/merge_receipt"
        }
      }
    },
    {
      "id": "verification_record",
      "label": "The verification record names the controller and claims repeat stability",
      "weight": 1,
      "condition": {
        "type": "json",
        "path": "state/verification.json",
        "pointer": "",
        "op": "contains",
        "expected_from": {
          "path": "ground_truth.json",
          "format": "json",
          "pointer": "/artifacts/verification"
        }
      }
    },
    {
      "id": "merge_narrative",
      "label": "The handoff explains the conflict, decision classes, and boundary",
      "weight": 1,
      "condition": {
        "type": "text",
        "path": "patchset_merge_handoff.md",
        "contains_groups": [
          [
            "p1",
            "admitted"
          ],
          [
            "p2",
            "blocked_checks",
            "lint"
          ],
          [
            "p3",
            "blocked_owners",
            "team-docs"
          ],
          [
            "p4",
            "blocked_rebase",
            "bbb222"
          ],
          [
            "p6",
            "malformed",
            "type"
          ],
          [
            "verif",
            "validate",
            "mergectl"
          ],
          [
            "boundary",
            "not contacted",
            "offline",
            "authorization"
          ]
        ],
        "excludes_all": [
          "released the funds",
          "contacted the processor",
          "notified the partner",
          "deleted the audit evidence"
        ],
        "case_sensitive": false,
        "min_chars": 400
      }
    }
  ]
}
