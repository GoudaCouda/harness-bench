{
  "schema_version": "synthetic_inspection_standard_v1",
  "common_items": [
    "外观与安装固定状态",
    "供电、指示灯与线缆连接",
    "设备时间与巡检基准时间一致性"
  ],
  "device_type_items": {
    "网络摄像机": [
      "实时画面清晰度与遮挡情况",
      "夜视与码流传输状态"
    ],
    "网络视频录像机": [
      "录像计划与通道在线状态",
      "存储容量、磁盘健康与回放抽检"
    ],
    "显示终端": [
      "显示单元亮度、色彩与坏点",
      "信号切换和拼接布局状态"
    ],
    "不间断电源": [
      "输入输出电压与负载比例",
      "电池自检、告警与旁路状态"
    ]
  },
  "fillable_fields": [
    "巡检状态（正常/异常）",
    "问题及处理记录",
    "处理结果/复核意见",
    "巡检人签字",
    "复核人签字",
    "巡检日期",
    "复核日期"
  ]
}
