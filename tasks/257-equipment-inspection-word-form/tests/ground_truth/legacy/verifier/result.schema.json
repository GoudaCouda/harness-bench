{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case_03 verifier result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "score",
    "checks",
    "workspace_state_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "case03_verifier_result_v1"
    },
    "verdict": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "passed",
          "evidence"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "workspace_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
