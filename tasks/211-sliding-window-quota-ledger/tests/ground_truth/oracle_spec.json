    },
    {
      "id": "receipt_summary",
      "label": "The receipt reports canonical counts and executed_debit_cents",
      "weight": 2,
      "condition": {
        "type": "json",
        "path": "state/quota_receipt.json",
        "pointer": "",
        "op": "contains",
        "expected_from": {
          "path": "ground_truth.json",
          "format": "json",
          "pointer": "/artifacts/quota_receipt"
        }
      }
    },
    {
      "id": "verification_record",
      "label": "The verification record names the controller and claims repeat stability",
      "weight": 1,
      "condition": {
        "type": "json",
        "path": "state/verification.json",
        "pointer": "",
        "op": "contains",
        "expected_from": {
          "path": "ground_truth.json",
          "format": "json",
          "pointer": "/artifacts/verification"
        }
      }
    },
    {
      "id": "quota_narrative",
      "label": "The handoff explains windows, the expired refund, and the boundary",
      "weight": 1,
      "condition": {
        "type": "text",
        "path": "quota_window_handoff.md",
        "contains_groups": [
          ["e1"],
          ["burst"],
          ["daily", "86400"],
          ["q5", "burst_exceeded"],
          ["q6", "refund_expired"],
          ["q7", "daily_exceeded"],
          ["80000", "executed_debit_cents"],
          ["verif", "validate", "quotactl"],
          ["boundary", "offline", "authorization"]
