--- a/app/export_worker.py
+++ b/app/export_worker.py
@@ -9,18 +9,25 @@ def run_once(repo, object_store, retry_queue, worker_id, now):
-    job = repo.claim_next(worker_id, now)
+    job = repo.next_queued()
     if not job:
         return False
+    repo.mark_running(job.id, worker_id, now)
 
     rows = load_snapshot(job)
     payload, checksum = build_archive(rows, include_pii=job.include_pii)
     try:
         uploaded = object_store.put(job.object_key, payload, checksum=checksum)
-    except TransientUploadError:
+    except TransientUploadError as exc:
         retry_queue.publish(job.id)
-        repo.requeue(job.id, worker_id)
+        logger.warning("export upload deferred", extra={"job_id": job.id, "error": str(exc)})
+        uploaded = None
+    repo.mark_complete(
+        job.id,
+        etag=uploaded.etag if uploaded else None,
+        checksum=checksum,
+    )
     return True
