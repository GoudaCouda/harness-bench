{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case_09 verifier result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "score", "checks", "terminal_state_sha256", "candidate_unchanged"],
  "properties": {
    "schema_version": {"const": "case09_verifier_result_v1"},
    "verdict": {"enum": ["accept", "reject", "invalid"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "detail"],
        "properties": {
          "check_id": {"type": "string"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    },
    "terminal_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_unchanged": {"type": "boolean"}
  }
}
