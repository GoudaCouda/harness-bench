{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "run_id", "task_id", "host_alias", "hostname",
    "attempt_id", "host_runtime_root", "controller_runtime_root", "submission_relative_path",
    "contract_sha256", "resource_manifest_path", "candidate_container", "controller_container",
    "dynamic_labels", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "nami_work_candidate_runtime_ownership_v2"},
    "case_id": {"const": "case_10"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "host_alias": {"type": "string", "minLength": 1},
    "hostname": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "host_runtime_root": {"type": "string", "pattern": "^/"},
    "controller_runtime_root": {"const": "/runtime"},
    "submission_relative_path": {"const": "submission"},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resource_manifest_path": {
      "type": "string",
      "pattern": "^artifacts/resource_governance/"
    },
    "candidate_container": {"$ref": "#/$defs/container"},
    "controller_container": {"$ref": "#/$defs/container"},
    "dynamic_labels": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "exact_id", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "exact_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["planned", "created", "running", "exited", "removed", "failed"]}
      }
    }
  }
}
