{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case 13 verifier result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "score", "checks", "violations"],
  "properties": {
    "schema_version": {"const": "case13_verifier_result_v1"},
    "verdict": {"enum": ["accept", "reject", "invalid"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "evidence"],
        "properties": {
          "check_id": {"type": "string"},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string"}
        }
      }
    },
    "violations": {"type": "array", "items": {"type": "string"}}
  }
}
