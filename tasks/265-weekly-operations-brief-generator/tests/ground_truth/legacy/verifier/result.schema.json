{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sft.local/schemas/case11_submission_evaluation_v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "evaluation_id", "candidate_script_sha256", "checks", "summary"],
  "properties": {
    "schema_version": {"const": "case11_submission_evaluation_v2"},
    "status": {"enum": ["passed", "failed", "invalid"]},
    "evaluation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"},
    "candidate_script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "detail", "evidence_refs"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
