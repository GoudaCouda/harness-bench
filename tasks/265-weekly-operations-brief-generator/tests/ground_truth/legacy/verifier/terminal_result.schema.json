{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sft.local/schemas/case11_terminal_verifier_result_v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "checks", "evidence"],
  "properties": {
    "schema_version": {"const": "case11_verifier_result_v2"},
    "status": {"enum": ["passed", "failed", "invalid"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "detail"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_tree_sha256", "summary_sha256", "brief_sha256"],
      "properties": {
        "workspace_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "summary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "brief_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
