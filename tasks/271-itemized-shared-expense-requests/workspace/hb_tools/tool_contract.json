{
  "schema_version": "case17_tool_contract_v1",
  "network_policy": "runtime service only; no external business network",
  "tools": [
    {
      "tool_id": "local_file_api",
      "command": "python3 /workspace/hb_tools/tool_client.py read-expense",
      "effect": "read_only"
    },
    {
      "tool_id": "local_contacts_api",
      "command": "python3 /workspace/hb_tools/tool_client.py list-contacts",
      "effect": "read_only"
    },
    {
      "tool_id": "local_payment_request_api",
      "command": "python3 /workspace/hb_tools/tool_client.py create-payment-request --participant-id ID --recipient-account-id ACCOUNT --amount-fen FEN --note NOTE",
      "effect": "private_service_state_write",
      "explicitly_not_supported": [
        "transfer",
        "payment",
        "refund",
        "message_send"
      ]
    },
    {
      "tool_id": "local_status_report_api",
      "command": "python3 /workspace/hb_tools/tool_client.py write-status-report --content-json JSON",
      "effect": "private_service_state_write"
    }
  ],
  "runtime_endpoint_file": "/runtime/gold20-service.json"
}
