    "role": "candidate-sandbox",
    "user": "2050:4007",
    "network_mode": "none",
    "published_ports": [],
    "readonly_rootfs": true,
    "cap_drop": ["ALL"],
    "security_options": ["no-new-privileges:true"],
    "cpu_cores": 2,
    "memory_bytes": 536870912,
